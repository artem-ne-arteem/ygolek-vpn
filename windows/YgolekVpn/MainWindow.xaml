<Window x:Class="YgolekVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ygolek VPN" Width="420" Height="720" MinWidth="380" MinHeight="640"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}">
    <Grid>
        <!-- Мягкое синее свечение сверху, как фон на сайте -->
        <Ellipse Width="520" Height="360" Margin="0,-210,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#332F7BFF" Offset="0" />
                    <GradientStop Color="#002F7BFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/mark.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Ygolek VPN" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10"
                        Padding="10,4" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusPillText" Text="Отключено" FontSize="12" Margin="6,0,0,0"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Экран входа -->
            <Border x:Name="LoginPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="22" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Вход через Telegram" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextAlignment="Center"
                               Text="Отсканируй код камерой телефона или нажми кнопку ниже" />
                    <Border Background="White" CornerRadius="16" Padding="12" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="196" Height="196" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <Button x:Name="OpenTelegramButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                            Click="OpenTelegram_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Открыть Telegram" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextAlignment="Center"
                               Text="Бот спросит, подтверждаешь ли ты вход на этом компьютере — нажми «Войти»." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Ellipse x:Name="LoginDot" Width="7" Height="7" Fill="{StaticResource Accent2}" VerticalAlignment="Center" />
                        <TextBlock x:Name="LoginStatus" Foreground="{StaticResource Muted}" Margin="8,0,0,0"
                                   Text="Ждём подтверждения в боте…" />
                    </StackPanel>
                    <Button x:Name="NewCodeButton" Style="{StaticResource GhostButton}" Content="Получить новый код"
                            Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="NewCode_Click" />
                </StackPanel>
            </Border>

            <!-- Главный экран -->
            <Grid x:Name="HomePanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Кнопка подключения и статус -->
                <StackPanel Margin="0,4,0,18">
                    <Grid Width="200" Height="180" HorizontalAlignment="Center">
                        <Ellipse x:Name="Glow" Width="148" Height="148" Fill="{StaticResource Ink}" Opacity="0.55">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="GlowEffect" Color="{StaticResource AccentColor}" BlurRadius="70"
                                                  ShadowDepth="0" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Button x:Name="ConnectButton" Style="{StaticResource PowerButton}" Click="Connect_Click"
                                ToolTip="Подключить" />
                    </Grid>
                    <TextBlock x:Name="ConnectionTitle" Text="Не подключено" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock x:Name="ConnectionStatus" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,4,0,0" Text="Выбери сервер и нажми кнопку" />
                </StackPanel>

                <!-- Серверы -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,14,14,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource Label}" Margin="4,0,0,10" />
                        <ListBox x:Name="ServerList" Grid.Row="1" ItemContainerStyle="{StaticResource ServerItem}">
                            <!-- свой шаблон: стандартный в неактивном состоянии заливает фон белым -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                        <TextBlock x:Name="ServersEmpty" Grid.Row="1" Foreground="{StaticResource Muted}" Margin="4,0,0,8"
                                   Text="Серверы появятся после оформления подписки." Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Подписка -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="ПОДПИСКА" Style="{StaticResource Label}" />
                                <TextBlock x:Name="SubscriptionTitle" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock x:Name="SubscriptionDetails" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="RenewButton" Style="{StaticResource GhostButton}" Content="Продлить"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Renew_Click" />
                        </Grid>
                        <ProgressBar x:Name="DaysBar" Style="{StaticResource DaysBar}" Margin="0,14,0,0" Maximum="30" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ошибки и низ окна -->
            <StackPanel Grid.Row="2">
                <Border x:Name="ErrorBox" Background="#1AF87171" BorderBrush="#40F87171" BorderThickness="1"
                        CornerRadius="12" Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="13" />
                </Border>
                <Grid Margin="2,14,2,0">
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Support_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="12"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="Поддержка" Foreground="{StaticResource Muted}" FontSize="12" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogoutButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            Visibility="Collapsed" Click="Logout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LogoutText" Text="Выйти" Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
