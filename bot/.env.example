# Telegram
BOT_TOKEN=123456:your-bot-token-from-botfather
# Твой Telegram user_id (через запятую, если админов несколько) — узнать
# можно у @userinfobot. Этим id доступна админ-панель (/admin) и /stats.
ADMIN_IDS=
# Админы по username (без @, через запятую). По умолчанию — fyave.
# Надёжнее указывать id: username можно сменить, а id — нет.
ADMIN_USERNAMES=fyave

# Адрес мини-аппа (страница /app на сайте). Пусто — кнопки мини-аппа скрыты.
WEBAPP_URL=https://ygolek-vpn.online/app

# Панель H1 (h1cloud) — https://my.h1cloud.net/api-docs#h1-panel-api
# Пока не заполнил URL и токен — оставь H1_PANEL_MOCK=true, бот будет
# выдавать фейковые ссылки, чтобы можно было протестировать весь флоу.
H1_PANEL_MOCK=true
# Адрес панели из раздела «API-доступ» (без /api на конце). Если сервер
# зарубежный и не отвечает — используй вариант direct-<node>.h1cloud.net:<port>.
# Пример: https://<node>.h1cloud.net:<port>
H1_PANEL_URL=
# Токен API панели (не ключ кабинета h1_…)
H1_PANEL_TOKEN=
# Необязательно: ID inbound-ов через запятую (GET /api/inbounds). Пусто —
# панель сама выбирает inbound-ы по умолчанию.
H1_PANEL_INBOUND_IDS=
# Необязательно: каналы через запятую — main, reality, bs, wscdn
H1_PANEL_CHANNELS=

# ЮKassa (пока не используется, оставь пустым до подключения)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Общая с сайтом Postgres-база (см. site/.env.local после `vercel integration
# add neon` — используй DATABASE_URL_UNPOOLED оттуда, схему поменяй на
# postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
