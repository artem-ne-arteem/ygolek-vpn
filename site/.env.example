NEXT_PUBLIC_BOT_USERNAME=ygolek_vpn_bot
SESSION_SECRET=

# Панель H1 (h1cloud) — те же значения, что в bot/.env
H1_PANEL_MOCK=true
H1_PANEL_URL=
H1_PANEL_TOKEN=

# Общая с ботом база (Neon)
DATABASE_URL=
BOT_TOKEN=

# Platega — оплата картой и СБП (те же значения, что у бота). Пусто — кнопка
# «Оплатить картой» показывает заглушку. Колбэк в кабинете Platega:
# https://<сайт>/api/platega/callback
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
